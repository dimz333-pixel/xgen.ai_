<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>X_GEN | Artificial Intelligence</title>
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" href="icon-192.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style>
        /* ================================================================
           RESET & ROOT — BLACK CLASSIC PREMIUM
           ================================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #111111;
            --bg-card: #1a1a1a;
            --bg-input: #1e1e1e;
            --bg-hover: #242424;
            --bg-active: #2a2a2a;
            --text-primary: #f0f0f0;
            --text-secondary: #a0a0a0;
            --text-muted: #606060;
            --border-color: #2a2a2a;
            --border-light: #333333;
            --shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
            --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.3);
            --primary: #7c5cfc;
            --primary-dark: #5a3fd4;
            --primary-glow: rgba(124, 92, 252, 0.15);
            --primary-soft: rgba(124, 92, 252, 0.06);
            --danger: #ef4444;
            --danger-glow: rgba(239, 68, 68, 0.15);
            --success: #22c55e;
            --radius: 14px;
            --radius-sm: 8px;
            --radius-full: 50px;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --transition: all 0.25s ease;
            --transition-slow: all 0.4s ease;
        }

        html,
        body {
            height: 100%;
            font-family: var(--font);
            background: var(--bg-primary);
            color: var(--text-primary);
            overflow: hidden;
        }

        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #666;
        }

        .app {
            display: flex;
            height: 100vh;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0;
            background: var(--bg-primary);
            position: relative;
        }

        /* ================================================================
           SIDEBAR OVERLAY
           ================================================================ */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 998;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .sidebar-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        /* ================================================================
           SIDEBAR MENU — CLASSIC BLACK
           ================================================================ */
        .sidebar-menu {
            position: fixed;
            top: 0;
            left: -320px;
            width: 320px;
            max-width: 85vw;
            height: 100%;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-color);
            z-index: 999;
            padding: 20px 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: var(--transition-slow);
            box-shadow: var(--shadow);
            overflow-y: auto;
        }

        .sidebar-menu.open {
            left: 0;
        }

        .sidebar-menu .brand {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar-menu .brand .brand-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-menu .brand .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            box-shadow: 0 0 20px var(--primary-glow);
        }

        .sidebar-menu .brand .brand-name {
            font-weight: 700;
            font-size: 16px;
        }
        .sidebar-menu .brand .brand-name span {
            color: var(--primary);
        }
        .sidebar-menu .brand .brand-sub {
            font-size: 9px;
            color: var(--text-muted);
            font-weight: 400;
            display: block;
            margin-top: 1px;
        }

        .sidebar-menu .brand .close-menu {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 22px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            transition: var(--transition);
        }
        .sidebar-menu .brand .close-menu:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .sidebar-menu .btn-new-chat {
            width: 100%;
            padding: 10px 16px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
            border-radius: var(--radius-sm);
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 20px var(--primary-glow);
        }
        .sidebar-menu .btn-new-chat:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px var(--primary-glow);
        }

        .sidebar-menu .history-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            font-weight: 600;
            margin-top: 4px;
        }

        .sidebar-menu .history-list {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
            max-height: 400px;
        }

        .sidebar-menu .history-item {
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 13px;
            color: var(--text-secondary);
            transition: var(--transition);
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .sidebar-menu .history-item:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-light);
        }
        .sidebar-menu .history-item.active {
            background: var(--primary-soft);
            color: var(--text-primary);
            border-color: var(--primary);
        }
        .sidebar-menu .history-item span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .sidebar-menu .history-item .delete-chat {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
            padding: 2px 6px;
            border-radius: 4px;
            transition: var(--transition);
            /* no emoji */
        }
        .sidebar-menu .history-item .delete-chat:hover {
            color: var(--danger);
            background: rgba(239, 68, 68, 0.1);
        }

        .sidebar-menu .history-empty {
            color: var(--text-muted);
            font-size: 13px;
            text-align: center;
            padding: 20px 0;
        }

        .sidebar-menu .footer-menu {
            border-top: 1px solid var(--border-color);
            padding-top: 12px;
            font-size: 10px;
            color: var(--text-muted);
            text-align: center;
        }
        .sidebar-menu .footer-menu .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
            margin-right: 6px;
            animation: pulse-dot 2s infinite;
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0.3;
            }
        }

        /* ================================================================
           CUSTOM DELETE MODAL (tanpa emoji)
           ================================================================ */
        .delete-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            animation: modalFade 0.25s ease;
        }
        .delete-modal-overlay.active {
            display: flex;
        }
        @keyframes modalFade {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .delete-modal {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            border: 1px solid var(--border-color);
            padding: 28px 24px;
            max-width: 380px;
            width: 90%;
            text-align: center;
            box-shadow: var(--shadow);
        }
        .delete-modal .modal-title {
            font-size: 17px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 6px;
        }
        .delete-modal .modal-desc {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 20px;
            line-height: 1.6;
        }
        .delete-modal .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }
        .delete-modal .modal-actions button {
            padding: 8px 24px;
            border: none;
            border-radius: var(--radius-full);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
        }
        .delete-modal .modal-actions .btn-cancel {
            background: var(--bg-card);
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }
        .delete-modal .modal-actions .btn-cancel:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-light);
        }
        .delete-modal .modal-actions .btn-delete {
            background: linear-gradient(135deg, var(--danger), #b91c1c);
            color: #fff;
            box-shadow: 0 4px 20px var(--danger-glow);
        }
        .delete-modal .modal-actions .btn-delete:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 30px var(--danger-glow);
        }

        /* ================================================================
           MAIN CHAT
           ================================================================ */
        .main-chat {
            flex: 1;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transition: var(--transition-slow);
            box-shadow: var(--shadow);
        }

        .chat-header {
            padding: 12px 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-primary);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 8px;
            transition: var(--transition);
            z-index: 10;
        }

        .chat-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .chat-header-left .hamburger {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 22px;
            cursor: pointer;
            padding: 4px 6px;
            border-radius: var(--radius-sm);
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .chat-header-left .hamburger:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }
        .chat-header-left .brand-title {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .chat-header-left h2 {
            font-size: 18px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--text-primary), var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.3px;
        }
        .chat-header-left .sub-title {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 400;
            -webkit-text-fill-color: var(--text-muted);
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 500;
            color: var(--success);
            background: rgba(34, 197, 94, 0.08);
            padding: 4px 14px;
            border-radius: var(--radius-full);
            border: 1px solid rgba(34, 197, 94, 0.15);
        }
        .status-indicator .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--success);
            display: inline-block;
            animation: pulse-dot 2s infinite;
        }
        .status-indicator .status-text {
            color: var(--success);
            font-weight: 600;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-cyber {
            background: linear-gradient(135deg, var(--danger), #b91c1c);
            border: none;
            border-radius: var(--radius-full);
            padding: 6px 18px;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 20px var(--danger-glow);
            font-family: var(--font);
            letter-spacing: 0.3px;
        }
        .btn-cyber:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 30px var(--danger-glow);
        }
        .btn-cyber:active {
            transform: scale(0.95);
        }

        /* ================================================================
           WELCOME SCREEN
           ================================================================ */
        .welcome-screen {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            text-align: center;
            animation: fadeUp 0.6s ease;
            gap: 20px;
        }
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .welcome-screen .welcome-icon {
            font-size: 56px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            width: 88px;
            height: 88px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 40px var(--primary-glow);
            color: #fff;
            font-weight: 800;
            font-size: 32px;
        }
        .welcome-screen .welcome-title {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }
        .welcome-screen .welcome-title span {
            background: linear-gradient(135deg, var(--text-primary), var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .welcome-screen .welcome-desc {
            font-size: 15px;
            color: var(--text-secondary);
            max-width: 480px;
            line-height: 1.8;
        }
        .welcome-screen .welcome-desc strong {
            color: var(--text-primary);
        }
        .btn-start-chat {
            padding: 14px 44px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
            border-radius: var(--radius-full);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 30px var(--primary-glow);
            font-family: var(--font);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-start-chat:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px var(--primary-glow);
        }
        .btn-start-chat:active {
            transform: scale(0.97);
        }
        .btn-start-chat .btn-icon-text {
            font-size: 16px;
        }

        .chat-mode {
            display: none;
            flex: 1;
            flex-direction: column;
            position: relative;
            min-height: 0;
        }
        .chat-mode.active {
            display: flex;
        }
        .welcome-screen.hidden {
            display: none;
        }

        /* ================================================================
           MESSAGES + COPY BUTTON
           ================================================================ */
        .messages-area {
            flex: 1;
            padding: 20px 24px 8px 24px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: transparent;
            scrollbar-width: thin;
            scrollbar-color: #444 transparent;
            min-height: 0;
        }
        .messages-area::-webkit-scrollbar {
            width: 4px;
        }
        .messages-area::-webkit-scrollbar-track {
            background: transparent;
        }
        .messages-area::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 10px;
        }
        .messages-area::-webkit-scrollbar-thumb:hover {
            background: #666;
        }

        .message {
            max-width: 82%;
            padding: 0;
            border-radius: 0;
            animation: fadeUp 0.35s ease;
            word-wrap: break-word;
            position: relative;
            transition: var(--transition);
            display: flex;
            gap: 12px;
            flex-shrink: 0;
        }

        .message .message-content {
            flex: 1;
            min-width: 0;
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            line-height: 1.7;
            font-size: 14px;
            transition: var(--transition);
            position: relative;
        }

        .message .msg-label {
            font-size: 10px;
            font-weight: 600;
            opacity: 0.5;
            margin-bottom: 3px;
            letter-spacing: 0.3px;
        }
        .message .timestamp {
            font-size: 9px;
            color: var(--text-muted);
            margin-top: 4px;
            opacity: 0.6;
            text-align: right;
        }

        .message.user .message-content {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-soft);
        }
        .message.bot .message-content {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-soft);
        }

        .message .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            color: #fff;
            margin-top: 2px;
        }
        .message .avatar.user-avatar {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            box-shadow: 0 0 20px var(--primary-glow);
        }
        .message .avatar.bot-avatar {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
        }

        .message.stagger {
            animation: fadeUp 0.35s ease forwards;
            opacity: 0;
        }
        .message.stagger:nth-child(1) {
            animation-delay: 0.05s;
        }
        .message.stagger:nth-child(2) {
            animation-delay: 0.1s;
        }
        .message.stagger:nth-child(3) {
            animation-delay: 0.15s;
        }
        .message.stagger:nth-child(4) {
            animation-delay: 0.2s;
        }
        .message.stagger:nth-child(5) {
            animation-delay: 0.25s;
        }
        .message.stagger:nth-child(6) {
            animation-delay: 0.3s;
        }
        .message.stagger:nth-child(7) {
            animation-delay: 0.35s;
        }
        .message.stagger:nth-child(8) {
            animation-delay: 0.4s;
        }
        .message.stagger:nth-child(9) {
            animation-delay: 0.45s;
        }
        .message.stagger:nth-child(10) {
            animation-delay: 0.5s;
        }

        .message.user {
            align-self: flex-end;
            flex-direction: row-reverse;
        }
        .message.user .avatar {
            order: 2;
        }
        .message.user .message-content {
            order: 1;
        }
        .message.user .msg-label {
            text-align: right;
        }
        .message.user .timestamp {
            text-align: left;
        }

        /* Tombol copy di setiap pesan (tanpa emoji) */
        .message .copy-msg-btn {
            position: absolute;
            bottom: 6px;
            right: 8px;
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 2px 10px;
            font-size: 10px;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
            font-family: var(--font);
            opacity: 0;
            pointer-events: none;
        }
        .message:hover .copy-msg-btn {
            opacity: 1;
            pointer-events: auto;
        }
        .message .copy-msg-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-light);
        }

        /* ================================================================
           THINKING UI
           ================================================================ */
        .thinking-wrapper {
            align-self: flex-start;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 18px;
            background: var(--bg-input);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            animation: fadeUp 0.3s ease;
        }
        .thinking-wrapper .thinking-text {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 500;
        }
        .thinking-wrapper .thinking-dots {
            display: flex;
            gap: 4px;
        }
        .thinking-wrapper .thinking-dots span {
            width: 6px;
            height: 6px;
            background: var(--primary);
            border-radius: 50%;
            animation: thinkingAnim 1.4s infinite;
        }
        .thinking-wrapper .thinking-dots span:nth-child(2) {
            animation-delay: 0.2s;
        }
        .thinking-wrapper .thinking-dots span:nth-child(3) {
            animation-delay: 0.4s;
        }
        @keyframes thinkingAnim {
            0%,
            60%,
            100% {
                transform: translateY(0);
                opacity: 0.3;
            }
            30% {
                transform: translateY(-8px);
                opacity: 1;
            }
        }

        /* ================================================================
           CODE BLOCK — tanpa emoji
           ================================================================ */
        .code-block-wrapper {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 6px;
            margin: 6px 0;
            border-left: 2px solid var(--primary);
            overflow: hidden;
            transition: var(--transition);
        }
        .code-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 4px 12px;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--border-color);
            font-size: 11px;
            font-weight: 500;
